classDiagram
    class Task {
        +str description
        +str time
        +int duration_minutes
        +str frequency
        +str priority
        +bool completed
        +str pet_name
        +date due_date
        +mark_complete() None
        +priority_rank() int
        +next_occurrence() Task
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task) None
        +remove_task(task) None
        +get_pending_tasks() list~Task~
    }

    class Owner {
        +str name
        +int available_minutes
        +list~Pet~ pets
        +add_pet(pet) None
        +remove_pet(pet) None
        +get_all_tasks() list~Task~
    }

    class Scheduler {
        +Owner owner
        +list skipped_tasks
        +get_all_tasks() list~Task~
        +sort_by_time(tasks) list~Task~
        +filter_tasks(pet_name, completed) list~Task~
        +get_pending_tasks(pet_name) list~Task~
        +mark_task_complete(task) Task
        +detect_conflicts(tasks) list~str~
        +generate_daily_plan(on_date) list~Task~
        +explain_plan() str
    }

    Owner "1" --> "*" Pet : has
    Pet "1" --> "*" Task : has
    Scheduler --> Owner : reads tasks via get_all_tasks()
    Scheduler ..> Task : sorts, filters, plans
    Task ..> Task : next_occurrence() creates
